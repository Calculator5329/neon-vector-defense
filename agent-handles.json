      "targets": [
        "replay.viewer.loading",
        "replay.viewer.unavailable",
        "replay.viewer.root"
      ],
      "reason": "One legacy id sat on three mutually exclusive replay states (loading, unavailable link, loaded viewer); each state now has its own identity."
    },
    "replay-exit": "replay.viewer.exit",
    "replay-play": "replay.controls.play",
    "map-theme-picker": "ui.map-theme-picker.root",
    "map-theme-*": "ui.map-theme-picker.theme-*",
    "ai-widget": "app.ai-help.root",
    "message-widget": "app.feedback.root"
  },
  "adoption": {
    "visualReviewRequired": true,
    "reviewSurfaces": [
      {
        "id": "menu-deploy",
        "route": "/?demo=1",
        "label": "Main menu, deploy tab (demo mode, age gate bypassed, no writes)"
      },
      {
        "id": "age-gate",
        "route": "/",
        "label": "Age gate on a first visit"
      },
      {
        "id": "privacy",
        "route": "/privacy",
        "label": "Privacy controls page"
      },
      {
        "id": "replay-unavailable",
        "route": "/?run=r_handlesreview01",
        "label": "Replay link for a run that does not exist"
      }
    ],
    "journeyVerifyCommand": "node ./tests/e2e/run-playwright.mjs tests/e2e/journeys.generated.spec.ts"
  }
}
